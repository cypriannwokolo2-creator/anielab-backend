# Copy to .env on the VM and fill in the secrets.
# Sources:
#   Supabase: Dashboard -> Settings -> API keys.
#   MinIO: creds you set when first starting the MinIO container.
#   Stellar: generate a testnet keypair with `stellar keys generate <name>`
#     then export the secret from ~/.config/stellar/identity/<name>.toml
#   Brevo: API key at https://app.brevo.com -> Settings -> SMTP & API -> API keys
#   Pinata (optional, removed in MinIO migration): pinata.cloud -> API Keys

# ─── [BUILD] NEXT_PUBLIC_* — inlined by next build into client bundles ────
# deploy.sh sources this file and passes these to docker build as --build-arg.
# Set them BEFORE building the images, or the shipped site is broken.
# The anon key is public by design (shipped to every visitor's browser).
NEXT_PUBLIC_SUPABASE_URL=https://fazxuwimazzcrpeskjvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZhenh1d2ltYXp6Y3JwZXNranZyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU2ODAwNTQsImV4cCI6MjEwMTI1NjA1NH0.tXpb3xa9RDtOXXJZnPEKMB_pcQ2YoUNQfewnn5E7I0o
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_USDC_SAC_TESTNET=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_BACKEND_URL=https://api.anielab.app
NEXT_PUBLIC_MEDIA_BASE_URL=https://minio.anielab.app

# ─── [RUNTIME] Backend secrets (injected via env_file: .env) ─────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DEPLOYER_SECRET_KEY=
WASM_PATH=./contracts/revenue_splitter.wasm

# Pinata was replaced by MinIO (ADR-002). The PINATA_JWT var is kept for
# backward compatibility — it's no longer read by any code. Remove after
# you confirm the MinIO upload flow works end-to-end.
PINATA_JWT=

# ─── [RUNTIME] MinIO (self-hosted S3, replaces Pinata) ──────────────────
MINIO_ENDPOINT=minio
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=anielab-media

# ─── [RUNTIME] Web admin gate ───────────────────────────────────────────
# Server-side runtime var. Set to "false" to close the admin panel to
# non-admins. Unset or "true" opens it to everyone.
ADMIN_OPEN=false
# Hardcoded admin password for admin API calls (x-admin-password header).
# Change this periodically. Used as a lightweight gate alongside Supabase auth.
ADMIN_PASSWORD=changeme-strong-password

# ─── [RUNTIME] Caddy reverse proxy ──────────────────────────────────────
# The DNS A/AAAA records for app/api/minio.${DOMAIN} must point to the VM's
# static public IP before Caddy starts, or Let's Encrypt issuance fails.
# Copy to .env (not .env.local) on the VM — docker-compose's env_file reads it.
DOMAIN=anielab.app

# ─── [OPTIONAL] WalletConnect ───────────────────────────────────────────
# Unset = WalletConnect module is not loaded (Freighter-only).
# Get a project ID at https://cloud.walletconnect.com
#NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── [OPTIONAL] XLM→USDC fallback rate (used when cache is cold) ────────
#NEXT_PUBLIC_XLM_USDC_RATE=0.12

# ─── [OPTIONAL] Brevo transactional email (ADR-003) ─────────────────────
# Not yet wired into the code. Keep for future auth/notification emails.
#BREVO_API_KEY=your-brevo-api-key-here