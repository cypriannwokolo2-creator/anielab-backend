# Dependencies — reinstalled inside the image via `npm ci`. The host
# node_modules may be platform-mismatched (Windows native binaries) and
# must never be copied into the Linux image.
/node_modules
/.pnp
/.yarn

# Build output — produced fresh inside the image.
/.next
/out
/build
/coverage

# Secrets & local env — must never be baked into the image (ADR-001: secrets
# stay out of the image; they're injected at runtime via env/compose).
/.env
/.env.*
!/.env.example

# Supabase local state — schema migrations run from CI (`supabase db push`),
# not inside the container. Keep the image lean and avoid shipping local DB
# config or a local Postgres data dir.
/supabase

# Vercel deploy cache.
/.vercel

# Version control & CI config.
/.git
/.github

# Docs & AI assistant config — not needed at runtime.
/README.md
/AGENTS.md
/CLAUDE.md

# TypeScript incremental build artifacts (regenerated during build).
/*.tsbuildinfo
/next-env.d.ts

# Logs & OS cruft.
npm-debug.log*
*.pem
.DS_Store

# Docker self-reference.
/Dockerfile
/.dockerignore
